# Tailscale host
Host 100.105.211.56
  HostName 100.105.211.56
  User abdullah
  ForwardAgent yes

# 130.0.0.104 is reachable as two users. Each needs its own alias — SSH applies
# the first matching block per option, so the old duplicate `Host 130.0.0.104`
# (User noco) never took effect. `ssh 130.0.0.104` and `ssh server-root` -> root.
Host server-root 130.0.0.104
  HostName 130.0.0.104
  User root
  ForwardAgent yes

Host server-noco
  HostName 130.0.0.104
  User noco
  ForwardAgent yes

# Oracle VPS (public reverse-proxy for Plex over tailnet).
# `oracle` -> public IP; `oracle-ts` -> tailnet IP / MagicDNS name.
Host oracle oracle-vps 129.146.179.208
  HostName 129.146.179.208
  User ubuntu
  ForwardAgent yes

Host oracle-ts
  HostName 100.127.58.81
  User ubuntu
  ForwardAgent yes

Host github.com
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
