# Homelab Sever
Host homelab
  HostName 192.168.0.100
  User abdullah
  ForwardAgent yes

Host homelab-ts
  HostName 100.125.140.11
  User abdullah
  ForwardAgent yes

# Oracle VPS relays
# Dubai   (me-dubai-1):   `oracle-dxb` -> public IP, `oracle-dxb-ts` -> tailnet IP.
Host oracle 145.241.121.9
  HostName 145.241.121.9
  User ubuntu
  ForwardAgent yes

Host oracle-ts
  HostName 100.107.165.88
  User ubuntu
  ForwardAgent yes

# Phoenix (us-phoenix-1): `oracle`     -> public IP, `oracle-ts`     -> tailnet IP.
Host oracle-us 129.146.179.208
  HostName 129.146.179.208
  User ubuntu
  ForwardAgent yes

Host oracle-us-ts
  HostName 100.127.58.81
  User ubuntu
  ForwardAgent yes

# GitHub
Host github.com
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519

# Qubes (Work)
Host qubes-root 130.0.0.104
