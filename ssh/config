# Homelab Sever
Host homelab
  HostName 192.168.0.100
  User abdullah
  ForwardAgent yes

Host homelab-ts
  HostName 100.125.140.11
  User abdullah
  ForwardAgent yes

# Oracle VPS relays
# Phoenix (us-phoenix-1): `oracle`     -> public IP, `oracle-ts`     -> tailnet IP.
Host oracle oracle-vps 129.146.179.208
  HostName 129.146.179.208
  User ubuntu
  ForwardAgent yes

Host oracle-ts
  HostName 100.127.58.81
  User ubuntu
  ForwardAgent yes

# Dubai   (me-dubai-1):   `oracle-dxb` -> public IP, `oracle-dxb-ts` -> tailnet IP.
Host oracle-dxb 141.145.152.160
  HostName 141.145.152.160
  User ubuntu
  ForwardAgent yes

Host oracle-dxb-ts
  HostName 100.121.95.21
  User ubuntu
  ForwardAgent yes

# GitHub
Host github.com
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519

# Qubes (Work)
Host server-root 130.0.0.104
