# ~/.zshenv — runs for every zsh, interactive or not.
#
# Keep this file small. Put anything a non-interactive shell needs here.
# `ssh host command` does not read .zshrc, so PATH belongs here.

# uv
export PATH="$HOME/.local/bin:$PATH"

# Rust / Cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Homebrew. Needed here so `ssh host command` and mosh-server find brew tools.
if [[ -z ${HOMEBREW_PREFIX-} ]]; then
  if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
fi

# Check whether a command exists.
function exists() { command -v "$1" >/dev/null 2>&1 }

# NOTE: TERM is deliberately not set here.
# z4h used to need help finding terminfo. Ghostty now ships `xterm-ghostty` to
# remote hosts through its ssh-terminfo shell integration. Overriding TERM only
# throws away capabilities, such as styled and coloured underlines.
