abdullah.run, abdullah.diy {
	root * /srv
	file_server {
		precompressed zstd br gzip
	}
	encode zstd gzip

	# No cache-busting filenames here, so assets get a short window, not a long one.
	@static path *.css *.js *.svg *.avif *.png *.jpg *.jpeg *.pdf *.woff *.woff2
	@html not path *.css *.js *.svg *.avif *.png *.jpg *.jpeg *.pdf *.woff *.woff2
	header @static Cache-Control "public, max-age=14400, must-revalidate"
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# /media is write-once, so it caches far longer. `>` replaces the value @static
	# set. No `immutable`: a same-path replace would then stick in browsers.
	@media path /media/*
	header @media >Cache-Control "public, max-age=2592000"

	# VPS-only, outside the git repo.
	handle_path /media/* {
		root * /media
		file_server
	}

	# Styled 404 page, real status code.
	handle_errors {
		rewrite * /404.html
		file_server {
			precompressed zstd br gzip
		}
	}
}

# labels are right-to-left: 0=tld, 1=domain.
www.abdullah.run, www.abdullah.diy {
	redir https://{labels.1}.{labels.0}{uri} permanent
}

# Raw relay on 32400 (vps/relay.sh) for Plex apps. In Plex > Settings > Network:
# custom access URL https://plex.abdullah.run:443, secure connections Preferred
# (Required blocks Caddy's cert).
plex.abdullah.run {
	reverse_proxy 100.125.140.11:32400
}

jellyfin.abdullah.run {
	reverse_proxy 100.125.140.11:8096
}

navidrome.abdullah.run {
	reverse_proxy 100.125.140.11:4533
}

# Reached by container name on this stack's compose network. The host firewall
# rejects 8000 anyway.
textcast.abdullah.run {
	reverse_proxy textcast-app:8000 {
		# Article bodies are megabytes of HTML.
		transport http {
			read_timeout 300s
		}
	}

	# Compress the prose, not the 30 MB Opus file.
	encode zstd gzip

	# The app sends `public, immutable`, wrong in front of Cloudflare: the audio
	# sits behind its own login. `>` replaces rather than adds a second header.
	@media path /media/*
	header @media >Cache-Control "private, max-age=31536000, immutable"
}

# Fallback bare-IP block — uncomment if the domains ever break.
