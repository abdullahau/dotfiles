# Copy to .env and fill in: cp .env.example .env
# Never commit .env (already covered by the repo's top-level .gitignore).
#
# Identity fields below are populated by `oci setup config` — see README.md
# for the full walkthrough. Every script in this directory sources this file.

TENANCY_OCID=
USER_OCID=
COMPARTMENT_OCID=       # root compartment = same value as TENANCY_OCID, unless you created sub-compartments
REGION=me-dubai-1
FINGERPRINT=            # printed by `oci setup config`, also under Console -> Profile -> API Keys
KEY_FILE=$HOME/.oci/oci_api_key.pem

# --- request_a1_instance.sh: existing subnet/image for the free A1.Flex shape ---
#   Subnet: oci network subnet list -c "$COMPARTMENT_OCID" --query 'data[].{name:"display-name",id:id}' --output table
SUBNET_OCID=
#   Image:  oci compute image list -c "$COMPARTMENT_OCID" --operating-system "Canonical Ubuntu" \
#             --operating-system-version "24.04" --shape VM.Standard.A1.Flex --query 'data[0].id' --raw-output
IMAGE_OCID=
