# ~/.zshrc — zsh4humans (z4h) on the homelab box.
#
# z4h bundles the prompt (powerlevel10k + gitstatusd), completions, fzf,
# autosuggestions, syntax highlighting and history search. Do not install
# those separately. Run `z4h update` to update everything.
#
# Load order matters. fpath must be complete before `z4h init`, because
# z4h runs compinit inside it. Anything that binds keys must come after.

# --------------------------------------------------------------
# Z4H CORE CONFIGURATION
# --------------------------------------------------------------
zstyle ':z4h:' auto-update      'ask'
zstyle ':z4h:' auto-update-days '7'
# 'mac' because the terminal is Ghostty on a Mac, even when this box is remote.
zstyle ':z4h:bindkey' keyboard  'mac'
zstyle ':z4h:' start-tmux       no
zstyle ':z4h:' term-shell-integration 'yes'
zstyle ':z4h:autosuggestions' forward-char 'accept'
zstyle ':z4h:direnv' enable 'no'

# fzf completion
zstyle ':z4h:fzf-complete' recurse-dirs 'yes'
zstyle ':z4h:fzf-complete' fzf-bindings tab:repeat

# SSH completions: offer hosts before users.
zstyle ':completion:*:ssh:argument-1:'       tag-order  hosts users
zstyle ':completion:*:scp:argument-rest:'    tag-order  hosts files users

# --------------------------------------------------------------
# SSH TELEPORTATION
# --------------------------------------------------------------
# Off everywhere. Turn it on per host if you want z4h copied over.
zstyle ':z4h:ssh:*' enable 'no'

# --------------------------------------------------------------
# PATH EXTENSIONS
# --------------------------------------------------------------
# Homebrew and ~/.local/bin are already on PATH from .zshenv.
path=(~/bin $path)
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && path=("$BUN_INSTALL/bin" $path)
typeset -U path PATH            # drop duplicate PATH entries

# --------------------------------------------------------------
# COMPLETION SYSTEM
# --------------------------------------------------------------
# This block must run before `z4h init`, which calls compinit.
#
# Generated completion scripts live in the cache, never in the dotfiles repo.
_zcompcache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions
[[ -d $_zcompcache ]] || mkdir -p $_zcompcache

# Write a tool's completion script to the cache. Rebuild it only when the tool
# binary is newer. `uv generate-shell-completion` alone costs 26 ms, so never
# run it at every shell start.
_gen_completion() {
  local name=$1 out=$_zcompcache/_$1
  shift
  [[ -n ${commands[$name]} ]] || return 0
  [[ -s $out && $out -nt ${commands[$name]} ]] && return 0
  "$@" >| $out 2>/dev/null || rm -f $out
}
_gen_completion uv  uv  generate-shell-completion zsh
_gen_completion uvx uvx --generate-shell-completion zsh

fpath=(
  $_zcompcache
  "$HOME/.zfunc"
  "$HOME/.docker/completions"
  $fpath
)
fpath=(${^fpath}(N-/))          # drop entries that do not exist

# --------------------------------------------------------------
# INITIALIZE Z4H
# --------------------------------------------------------------
# Everything below this line runs with z4h's plugins already loaded.
z4h init || return

# --------------------------------------------------------------
# HISTORY
# --------------------------------------------------------------
HISTFILE=$HOME/.zsh_history
# 2000 on purpose. atuin owns the searchable history; this file is only the
# fallback for when atuin is not loaded. z4h would otherwise set 1000000000.
HISTSIZE=2000
SAVEHIST=2000
setopt EXTENDED_HISTORY       # keep timestamps through a full file rewrite
setopt SHARE_HISTORY          # share history across sessions
setopt APPEND_HISTORY         # append rather than overwrite
setopt HIST_REDUCE_BLANKS     # clean up extra spaces
setopt HIST_IGNORE_SPACE      # ignore commands starting with a space
setopt HIST_EXPIRE_DUPS_FIRST # expire duplicates first
setopt HIST_IGNORE_ALL_DUPS   # ignore duplicates
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

# --------------------------------------------------------------
# SHELL OPTIONS
# --------------------------------------------------------------
setopt glob_dots              # show dotfiles in globs
setopt no_auto_menu           # require a second TAB to open the menu
setopt interactive_comments   # allow # comments on the command line
setopt auto_cd                # `foo` alone cds into ./foo
setopt extended_glob
setopt no_beep

# --------------------------------------------------------------
# ENVIRONMENT VARIABLES
# --------------------------------------------------------------
# XDG_CONFIG_HOME is set in .zshenv, so non-interactive shells get it too.
export EDITOR='micro'
export MICRO_TRUECOLOR=1
export GPG_TTY=$TTY
export CMDSTAN="$HOME/cmdstan"
export BRIDGESTAN="$HOME/cmdstan/bridgestan"

# z4h bundles fzf, so do not source it again. These only change what it lists.
export FZF_DEFAULT_COMMAND='fd --type f --type d --strip-cwd-prefix --hidden --follow --exclude .git --exclude .venv'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# --------------------------------------------------------------
# KEYBINDINGS
# --------------------------------------------------------------
# z4h already binds Home, End, Delete, Ctrl+Arrow and Alt+Arrow.
z4h bindkey undo Ctrl+/   Shift+Tab     # undo the last command line change
z4h bindkey redo Option+/               # redo the last undone change
z4h bindkey z4h-cd-back    Shift+Left   # cd into the previous directory
z4h bindkey z4h-cd-forward Shift+Right  # cd into the next directory
z4h bindkey z4h-cd-up      Shift+Up     # cd into the parent directory
z4h bindkey z4h-cd-down    Shift+Down   # cd into a child directory

# --------------------------------------------------------------
# AUTOLOAD FUNCTIONS
# --------------------------------------------------------------
autoload -Uz zmv

# --------------------------------------------------------------
# TOOL INTEGRATION
# --------------------------------------------------------------
# Each `tool init` call is a subprocess at every shell start. Cache the output
# and rebuild it only when the tool binary is newer.
_zinitcache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init
[[ -d $_zinitcache ]] || mkdir -p $_zinitcache

# usage: _cached_eval <tag> <command> [args...]
_cached_eval() {
  local tag=$1 out
  shift
  out=$_zinitcache/$tag.zsh
  [[ -n ${commands[$1]} ]] || return 0
  if [[ ! -s $out || ${commands[$1]} -nt $out ]]; then
    "$@" >| $out 2>/dev/null || { rm -f $out; return 1 }
    zcompile -R -- $out.zwc $out 2>/dev/null
  fi
  source $out
}

# Drop the caches after you change a tool's config, then open a new shell.
function zcache-clear() {
  local c=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
  rm -rf $c/init $c/completions
  print 'zsh caches cleared. Start a new shell.'
}

# --- Prompt theme ---
# Palettes live in zsh/p10k/. ~/.p10k.zsh reads the choice at startup, so this
# costs one short line read and no subprocess.
function prompt-theme() {
  local dir=${_p10k_dir:-${${:-~/.p10k.zsh}:A:h}/p10k}
  local state=${XDG_STATE_HOME:-$HOME/.local/state}/zsh/prompt-theme
  local -a themes=($dir/*.zsh(N:t:r))
  themes=(${themes:#base})
  if (( ! $# )); then
    local cur=catppuccin-mocha
    [[ -r $state ]] && read -r cur < $state
    print "current:   $cur"
    print "available: ${(j:, :)themes}"
    return
  fi
  (( ${themes[(Ie)$1]} )) || {
    print -u2 "no such theme: $1 (have: ${(j:, :)themes})"; return 1 }
  mkdir -p ${state:h}
  print -r -- $1 >| $state
  source $dir/$1.zsh
  (( ${+functions[p10k]} )) && p10k reload
}
_prompt_theme_complete() {
  local dir=${_p10k_dir:-${${:-~/.p10k.zsh}:A:h}/p10k}
  _values theme $dir/*.zsh(N:t:r)
}
compdef _prompt_theme_complete prompt-theme

_cached_eval zoxide    zoxide init zsh

# atuin last: it takes over Ctrl+R and Up from z4h's own history search.
_cached_eval atuin     atuin init zsh
_cached_eval atuin-hex atuin hex init

# --------------------------------------------------------------
# CUSTOM FUNCTIONS
# --------------------------------------------------------------

# Make a directory and cd into it.
function md() { [[ $# == 1 ]] && mkdir -p -- "$1" && builtin cd -- "$1" }
compdef _directories md

# Yazi wrapper. Leaves you in the directory yazi exited from.
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

# --------------------------------------------------------------
# ALIASES
# --------------------------------------------------------------
alias ls='eza -lAh --git --group-directories-first --icons=auto'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias cd="z"
alias man=batman
alias tree='tree -a -I ".git|.venv|__pycache__"'
alias trail='print -l $path'
alias "ip-local"="ip -4 route get 1.1.1.1 | awk '{print \$7; exit}'"
alias "ip-public"="curl checkip.amazonaws.com"
alias bbd='brew bundle dump --file=~/Developer/dotfiles/packages/Brewfile'
alias bup='brew update && brew upgrade --greedy && brew cleanup --prune=all'
alias disks='lsblk'
alias ports='sudo lsof -i -P -n'

# bun completions
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
