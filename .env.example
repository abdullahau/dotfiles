# Local secrets template. Copy to `.env` and fill in before running ./install.
#   cp .env.example .env
#
# `.env` is gitignored and sourced by the setup scripts (e.g. setup_ubuntu.zsh).

# Tailscale pre-auth key (https://login.tailscale.com/admin/settings/keys).
# If unset, setup_ubuntu.zsh skips `tailscale up` and prints a manual command.
TAILSCALE_AUTH_KEY=

# --- rclone / OneDrive (consumed by setup_rclone.zsh) -------------------------
#
# Get these from a machine that is already authenticated:
#   ./setup_rclone.zsh --export
#
# Or authenticate from scratch on a machine with a browser:
#   rclone config          # n) new remote -> name: onedrive -> storage: onedrive
#
# Single-quote the token: it is a JSON blob containing $ ! * / + which the shell
# would otherwise expand. The JSON itself never contains a single quote.

ONEDRIVE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"...","expires_in":3599}'
ONEDRIVE_DRIVE_ID='0000000000000000'
