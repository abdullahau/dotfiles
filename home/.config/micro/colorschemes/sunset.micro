# Sunset palette for micro. "default" has no background colour, so the
# terminal's own (transparent, blurred) background shows through.
color-link default "#E8DCE0"
color-link comment "#7D8799"
color-link identifier "#95B4DB"
color-link identifier.class "#95B4DB"
color-link identifier.var "#95B4DB"
color-link constant "#E6B18B"
color-link constant.number "#E6B18B"
color-link constant.string "#A9CBA9"
color-link symbol "#CBA6C3"
color-link symbol.brackets "#D8CCD2"
color-link symbol.tag "#7A9CC6"
color-link type "#7A9CC6"
color-link type.keyword "#F0C6A4"
color-link special "#C26967"
color-link statement "#C26967"
color-link preproc "#B48EAD"
color-link underlined "#7FB3B5"
color-link error "bold #E0605F"
color-link todo "bold #E6B18B"
color-link diff-added "#8FB394"
color-link diff-modified "#E6B18B"
color-link diff-deleted "#E0605F"
color-link gutter-error "#E0605F"
color-link gutter-warning "#E6B18B"
color-link statusline "#E8DCE0,#2F3849"
color-link tabbar "#E8DCE0,#2F3849"
color-link indent-char "#2F3849"
color-link line-number "#5F6B80"
color-link current-line-number "#E6B18B"
color-link cursor-line "#22303B"
color-link color-column "#2F3849"
color-link selection "#17232C,#E6B18B"
color-link type.extended "default"
