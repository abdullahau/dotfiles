// ~/.config/zellij/config.kdl
//
// Only the settings that differ from the shipped defaults live here.
//
// The previous version of this file was a verbatim copy of
// `zellij setup --dump-config`, 538 lines, for the three settings below. A
// pinned copy goes stale: it still read like zellij 0.43 while 0.45 shipped
// new keybinds and the zellij:link plugin. Keybinds merge with the defaults
// unless you write `keybinds clear-defaults=true`, so dropping the copy costs
// nothing and lets new defaults through.
//
// To see every option and its default:
//   zellij setup --dump-config | less
//
// To check this file after an edit:
//   zellij setup --check

// Catppuccin Frappe, as shipped with zellij. The prompt palettes in
// zsh/p10k/ are Mocha and Tokyo Night; Frappe sits between them and holds up
// against both.
theme "catppuccin-frappe"

// Classic full border around each pane, not the single title line.
pane_frame_style "full"

ui {
    pane_frames {
        rounded_corners true
    }
}
